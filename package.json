{
  "name": "presence-web-services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "check": "astro check",
    "lint": "eslint .",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:sites": "node scripts/build-sites.mjs",
    "serve:test": "node scripts/serve-local.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "test:all": "npm run check && npm run lint && npm run build:sites && npm test && npm run test:server",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "esbuild": "$esbuild"
  }
}
