# Server-only Sites runtime variables. Do not commit real values.
DEPLOYMENT_STAGE=staging
ENQUIRIES_ENABLED=false
APP_SECRET=
OWNER_REVIEW_TOKEN=
# Production keeps enquiries for 12 months (matches the privacy policy). Staging data expires after one day.
ENQUIRY_RETENTION_DAYS=365
PUBLIC_LAUNCH_APPROVED=false
# Email (Resend). Secret: without it, enquiries are still saved but no emails are sent.
RESEND_API_KEY=
# Optional overrides. Defaults come from src/config/business.ts.
MAIL_FROM=
NOTIFY_EMAIL=
