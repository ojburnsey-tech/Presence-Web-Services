---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'regular' | 'small';
  class?: string;
}
const { href, variant = 'primary', size = 'regular', class: className } = Astro.props;
---

<a
  href={href}
  class:list={['button', `button--${variant}`, { 'button--small': size === 'small' }, className]}
>
  <slot />
</a>
