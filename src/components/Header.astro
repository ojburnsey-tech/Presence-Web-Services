---
import Wordmark from './Wordmark.astro';
import Button from './Button.astro';
import { navigation } from '../config/business';
const path = Astro.url.pathname;
// The wordmark already links home, so the bar lists only the inner pages.
const barLinks = navigation.filter(({ href }) => href !== '/');
---

<header class="site-header">
  <div class="container header-inner">
    <nav class="header-nav" aria-label="Main navigation">
      <Wordmark current={path === '/'} />
      <ul class="header-links">
        {barLinks.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Button href="/contact/" size="small" class="header-cta">
      Free audit
    </Button>
    <a class="menu-control" href="#footer-navigation" data-menu-fallback>
      <span class="menu-control-icon" aria-hidden="true"></span>Menu
    </a>
    <button
      type="button"
      class="menu-control"
      aria-label="Open menu"
      aria-haspopup="dialog"
      aria-controls="site-menu"
      aria-expanded="false"
      data-menu-open
      hidden
    >
      <span class="menu-control-icon" aria-hidden="true"></span>Menu
    </button>
  </div>
  <dialog id="site-menu" class="menu-dialog" aria-labelledby="menu-title">
    <!-- Sits exactly over the Menu button, so open and close happen in the same place. -->
    <button
      type="button"
      class="menu-control menu-dismiss"
      aria-label="Close menu"
      data-menu-toggle
    >
      <span class="menu-control-icon" aria-hidden="true"></span>
      <span data-menu-label>Close</span>
    </button>
    <div class="menu-scrim" data-menu-backdrop aria-hidden="true"></div>
    <div class="menu-panel" data-menu-panel>
      <h2 id="menu-title" class="sr-only">
        Site navigation
      </h2>
      <nav class="menu-navigation" aria-label="Menu">
        {navigation.map(({ href, label }) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>
            {label}
          </a>
        ))}
      </nav>
      <div class="menu-audit">
        <Button href="/contact/">Request a free audit</Button>
      </div>
      <div class="menu-legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
      </div>
    </div>
  </dialog>
</header>
<script>
  import { setupMenu } from '../scripts/menu';
  setupMenu();
</script>
