---
import { faqs } from '../config/business';
---

<section class="section container prose-section" aria-labelledby="faq-heading">
  <h2 id="faq-heading">Common questions</h2>
  <div class="faq-list">
    {faqs.map((item) => (
      <details class="faq">
        <summary>
          {item.question}
          <span class="faq-symbol" aria-hidden="true"></span>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
  <p class="section-footnote">
    <a href="/contact/" class="inline-link">
      Ask about your own website
    </a>{' '}
    if your question isn’t answered here.
  </p>
</section>
