---
import { business } from '../config/business';
---

<section class="service-chooser" aria-labelledby="chooser-heading">
  <h2 id="chooser-heading">Which arrangement fits?</h2>
  <p>Start with the kind of help you need. This is a guide, not a quote.</p>
  <fieldset
    data-service-chooser
    data-one-off={business.prices.oneOff}
    data-ongoing={business.prices.ongoing}
  >
    <legend>What best describes your situation?</legend>
    <label>
      <input type="radio" name="support-choice" value="one-off" /> A specific issue on an existing
      website or profile
    </label>
    <label>
      <input type="radio" name="support-choice" value="ongoing" /> Regular updates, checks and
      improvements
    </label>
    <label>
      <input type="radio" name="support-choice" value="new-website" /> A first website or
      substantial rebuild
    </label>
  </fieldset>
  <div class="chooser-result" data-chooser-result aria-live="polite">
    <p>Compare the two support options below. New websites receive a separate quote.</p>
  </div>
  <noscript>
    <p>
      For a specific issue, consider one-off improvements. For regular work, consider ongoing
      support. A first website or major rebuild needs a separate quote.
    </p>
  </noscript>
</section>
<script>
  const chooser = document.querySelector('[data-service-chooser]');
  const result = document.querySelector('[data-chooser-result]');
  const oneOff = (chooser as HTMLElement)?.dataset.oneOff;
  const ongoing = (chooser as HTMLElement)?.dataset.ongoing;
  const options = {
    'one-off': [
      `One-off improvements, from £${oneOff}.`,
      'A defined set of smaller changes, agreed in writing. No subscription is required.',
      'Discuss one-off improvements',
    ],
    ongoing: [
      `Ongoing partnership, from £${ongoing}/month.`,
      'Agreed updates, checks and improvements. Scope and cancellation terms are confirmed in your proposal.',
      'Discuss ongoing support',
    ],
    'new-website': [
      'A separate website project.',
      `We discuss the pages, content and functions before quoting. The £${oneOff} starting price does not cover a full website.`,
      'Discuss a website project',
    ],
  };
  chooser?.addEventListener('change', (event) => {
    const input = event.target as HTMLInputElement;
    const option = options[input.value as keyof typeof options];
    if (!option || !result) return;
    const heading = document.createElement('h3');
    heading.textContent = option[0];
    const text = document.createElement('p');
    text.textContent = option[1];
    const link = document.createElement('a');
    link.className = 'inline-link';
    link.href = `/contact/?service=${input.value}`;
    link.textContent = option[2];
    result.replaceChildren(heading, text, link);
  });
</script>
