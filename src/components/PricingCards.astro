---
import Button from './Button.astro';
import { business } from '../config/business';
/**
 * The three ways to work together. Prices are starting points: every job is quoted in
 * writing. Nothing here may claim popularity, savings or results.
 */
const plans = [
  {
    id: 'one-off',
    name: 'One-off improvements',
    summary: 'Fix an agreed set of issues without signing up to monthly support.',
    from: true,
    amount: `£${business.prices.oneOff}`,
    unit: 'one-off',
    cta: 'Discuss a one-off project',
    items: [
      'Review of your website or Google profile',
      'The page, form or profile changes we agree',
      'A written summary of what changed',
    ],
  },
  {
    id: 'ongoing',
    name: 'Ongoing partnership',
    summary: 'Your website and Google profile looked after, with improvements agreed as you go.',
    from: true,
    amount: `£${business.prices.ongoing}`,
    unit: 'per month',
    cta: 'Discuss ongoing support',
    items: [
      'Regular website checks and updates',
      'Google Business Profile management',
      'Review monitoring and enquiry improvements, where agreed',
      'A monthly report on work done and next priorities',
    ],
  },
  {
    id: 'new-website',
    name: 'New website',
    summary: 'A separate quote once we understand the pages, content and features you need.',
    from: false,
    label: 'Per project',
    amount: 'Custom',
    unit: 'quote',
    cta: 'Discuss a website project',
    items: [
      'Pages planned around your services and customers’ questions',
      'Designed, built and tested on phones and desktops',
      'Handed over with your own access and documentation',
    ],
  },
];
---

<div class="pricing-grid">
  {plans.map((plan) => (
    <article class="price-card" aria-labelledby={`plan-${plan.id}`}>
      <h2 id={`plan-${plan.id}`}>{plan.name}</h2>
      <p class="price-summary">{plan.summary}</p>
      <p class="price">
        <span class="price-from">{plan.from ? 'From' : plan.label}</span>
        <span class="price-amount">{plan.amount}</span>
        <span class="price-unit">{plan.unit}</span>
      </p>
      <Button href={`/contact/?service=${plan.id}`} variant="secondary">
        {plan.cta}
      </Button>
      <p class="price-includes">Includes</p>
      <ul class="check-list check-list--included">
        {plan.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </article>
  ))}
</div>
{business.vatStatement && <p class="fine-print pricing-disclaimer">{business.vatStatement}</p>}
