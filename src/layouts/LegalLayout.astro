---
import Layout from './Layout.astro';
import PageIntro from '../components/PageIntro.astro';
interface Props {
  title: string;
  description: string;
  sections: { id: string; label: string }[];
  /** Date the document last changed, shown under the introduction. */
  updated: string;
}
const { title, description, sections, updated } = Astro.props;
---

<Layout title={title} description={description}>
  <PageIntro title={title} description={description} />
  <p class="container legal-updated">Last updated {updated}</p>
  <div class="container legal-layout">
    <nav class="legal-nav" aria-label="On this page">
      <p class="meta">On this page</p>
      {sections.map((section) => (
        <a href={`#${section.id}`}>{section.label}</a>
      ))}
    </nav>
    <article class="legal-content">
      <slot />
    </article>
  </div>
</Layout>
