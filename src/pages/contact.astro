---
import Layout from '../layouts/Layout.astro';
import FormField from '../components/FormField.astro';
import { business } from '../config/business';
const backendEnabled = process.env.ENQUIRY_BACKEND === 'sites';
---

<Layout
  title="Request a free audit"
  description="Tell Presence about your business and request a free, no-obligation public audit of your public website and online presence."
>
  <section class="container contact-layout">
    <div class="contact-intro">
      <h1>Request a free audit</h1>
      <p class="intro-copy">
        Tell us about your business and share your website or Google listing. We’ll review what your
        customers see and reply by email with what we found and what we’d fix first. If you want to
        go ahead, we’ll send a written quote. The audit is free and there’s no obligation.
      </p>
      <p class="contact-direct">
        You can also email{' '}
        <a class="inline-link" href={`mailto:${business.email}`}>
          {business.email}
        </a>
      </p>
    </div>
    <form
      class="enquiry-form"
      name="presence-review"
      method="POST"
      action="/api/enquiries"
      data-review-form
      data-hosted={String(backendEnabled)}
      aria-describedby="form-guidance"
    >
      <p class="form-guidance" id="form-guidance">
        All fields are required unless marked optional.
      </p>
      <input type="hidden" name="form-name" value="presence-review" />
      <input type="hidden" name="submission-id" value="" />
      <p hidden>
        <label>
          Leave this field empty
          <input name="bot-field" autocomplete="off" tabindex="-1" />
        </label>
      </p>
      <div class="form-grid">
        <FormField
          name="contact-name"
          label="Your name"
          required
          autocomplete="name"
          maxlength={100}
        />
        <FormField
          name="business-name"
          label="Business name"
          required
          autocomplete="organization"
          maxlength={160}
        />
        <FormField
          name="email"
          label="Email address"
          type="email"
          required
          autocomplete="email"
          maxlength={254}
        />
        <FormField
          name="telephone"
          label="Phone number"
          type="tel"
          required
          autocomplete="tel"
          maxlength={40}
        />
        <FormField
          name="website"
          label="Website address"
          type="url"
          placeholder="https://"
          maxlength={2048}
        />
        <FormField
          name="google-profile"
          label="Google listing link"
          type="url"
          placeholder="https://"
          maxlength={2048}
        />
        <FormField
          name="location"
          label="Town or area"
          autocomplete="address-level2"
          maxlength={120}
        />
        <div class="form-field">
          <label for="service">
            What do you need? <span>(optional)</span>
          </label>
          <select id="service" name="service" aria-describedby="service-error">
            <option value="not-sure">Not sure yet</option>
            <option value="one-off">One-off improvements</option>
            <option value="ongoing">Ongoing website care</option>
            <option value="new-website">A new website or rebuild</option>
          </select>
          <p class="field-error" id="service-error" aria-live="polite"></p>
        </div>
        <div class="form-field form-field--wide">
          <label for="goal">What would you like to improve?</label>
          <textarea
            name="goal"
            id="goal"
            rows="5"
            required
            maxlength="4000"
            aria-describedby="goal-help goal-error"
          ></textarea>
          <p class="field-help" id="goal-help">
            Please don’t include passwords.
          </p>
          <p class="field-error" id="goal-error" aria-live="polite"></p>
        </div>
      </div>
      <div class="form-status" role="alert" tabindex="-1" hidden></div>
      <div class="form-actions">
        <button class="button button--primary form-submit" type="submit">
          Send audit request
        </button>
        <p class="form-privacy">
          We only use your details to reply to this enquiry. See our{' '}
          <a class="inline-link" href="/privacy/">
            privacy policy
          </a>
          .
        </p>
      </div>
    </form>
  </section>
  <script>
    import { setupReviewForm } from '../scripts/form';
    setupReviewForm();
  </script>
</Layout>
