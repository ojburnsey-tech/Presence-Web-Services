---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { business, faqs, services } from '../config/business';
const { founder, prices } = business;
// The home page answers the questions an owner asks before enquiring, in their order.
const homeFaqs = faqs.filter((item) =>
  ['first-enquiry', 'existing-site', 'access', 'results'].includes(item.id),
);
---

<Layout
  title="Websites and Google presence for independent businesses"
  description="Websites, ongoing website care and Google Business Profile management for independent businesses in Northern Ireland and across the UK. Start with a free audit."
>
  <section class="container hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading">Your website should help bring in business.</h1>
    <div class="hero-body">
      <p class="hero-lead">
        Presence builds and looks after websites and Google Business Profiles for independent
        businesses in Northern Ireland and across the UK.
      </p>
      <div class="hero-actions">
        <Button href="/contact/" class="audit-button">
          Request a free audit
        </Button>
        <a class="link-arrow" href="/services/">
          See what we do
        </a>
      </div>
    </div>
  </section>

  <section class="section container split" aria-labelledby="offer-heading">
    <div class="split-intro">
      <h2 id="offer-heading">What we do</h2>
      <p>
        From a first website to keeping your Google listing accurate, the work is agreed in writing
        before it starts and you keep ownership of every account.
      </p>
    </div>
    <ul class="service-index">
      {services.map((service) => (
        <li>
          <a href={`/services/#${service.id}`}>{service.name}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container prose-section" aria-labelledby="start-heading">
    <h2 id="start-heading">How it starts</h2>
    <p class="lead">
      Send us your website or Google listing and we’ll look at it the way a customer would: how
      clearly your services are explained, whether your details are accurate, and how easy it is to
      get in touch. You’ll get a plain-English summary of what we found and what we’d fix first. The
      audit is free and there’s no obligation.
    </p>
    <p>
      If you want to go ahead, we send a written quote before any work begins. One-off improvements
      start at £{prices.oneOff}, ongoing care starts at £{prices.ongoing} a month, and new websites
      are quoted per project.
    </p>
    <a class="link-arrow" href="/pricing/">
      Pricing
    </a>
  </section>

  <section class="section container prose-section" aria-labelledby="founder-heading">
    {founder.photo && (
      <img
        class="founder-photo"
        src={founder.photo}
        alt={`${founder.name}, ${founder.role.toLowerCase()} of ${business.name}`}
        width={founder.photoWidth}
        height={founder.photoHeight}
        loading="lazy"
        decoding="async"
      />
    )}
    <h2 id="founder-heading">Who you’ll work with</h2>
    <p class="lead">
      Presence is run by {founder.name}, who reviews your site, does the work and answers your
      emails, so nothing gets lost between an account manager and a developer. Your website, domain
      and Google profile stay in your name throughout.
    </p>
    <a class="link-arrow" href="/about/">
      About Presence
    </a>
  </section>

  <section class="section container prose-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading">Questions</h2>
    <div class="faq-list">
      {homeFaqs.map((item) => (
        <details class="faq">
          <summary>
            {item.question}
            <span class="faq-symbol" aria-hidden="true" />
          </summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>
