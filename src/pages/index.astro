---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SampleReview from '../components/SampleReview.astro';
import { business, serviceGroups } from '../config/business';
const { founder, prices } = business;
---

<Layout
  title="Websites and Google presence for independent businesses"
  description="Websites, ongoing website care and Google Business Profile management for independent businesses in Northern Ireland and across the UK. Start with a free audit."
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <h1 id="hero-heading">Your website should help bring in business.</h1>
      <p class="hero-lead">
        Presence builds and looks after websites and Google Business Profiles for independent
        businesses in Northern Ireland and across the UK.
      </p>
      <div class="hero-actions">
        <Button href="/contact/" class="audit-button">
          Request a free audit
        </Button>
        <a class="link-arrow" href="/pricing/">
          See prices
        </a>
      </div>
      <p class="hero-note">Free, with no obligation. No account access needed.</p>
    </div>
  </section>

  <section class="section container" aria-labelledby="offer-heading">
    <h2 id="offer-heading" class="section-title">
      What we do
    </h2>
    <div class="offer-grid">
      {serviceGroups.map((group) => (
        <article class="offer">
          <h3>{group.name}</h3>
          <p>{group.homeSummary}</p>
          <a class="link-arrow" href={`/services/#${group.id}`}>
            {group.linkLabel}
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="audit-heading">
    <div class="container audit-layout">
      <div class="audit-copy">
        <h2 id="audit-heading">Start with a free audit.</h2>
        <p class="lead">
          Send us your website or Google listing. We’ll look at it the way a customer would, then
          explain what’s getting in the way of enquiries and what we’d fix first.
        </p>
        <dl class="audit-coverage">
          <div>
            <dt>Your website</dt>
            <dd>How clearly your services are explained, and how the pages work on a phone.</dd>
          </div>
          <div>
            <dt>Your Google presence</dt>
            <dd>Whether your business details are accurate and consistent wherever they appear.</dd>
          </div>
          <div>
            <dt>Making an enquiry</dt>
            <dd>How easy it is to find your contact details and ask for a quote.</dd>
          </div>
        </dl>
        <Button href="/contact/">Request a free audit</Button>
      </div>
      <SampleReview headingLevel={3} />
    </div>
  </section>

  <section class="section container pricing-summary" aria-labelledby="prices-heading">
    <div class="pricing-summary-intro">
      <h2 id="prices-heading" class="section-title">
        Clear prices, agreed in writing.
      </h2>
      <p>
        Every job starts with a written scope and quote. Nothing is charged until you’ve agreed to
        it.
      </p>
      <a class="link-arrow" href="/pricing/">
        Compare options
      </a>
    </div>
    <dl class="price-points">
      <div>
        <dt>One-off improvements</dt>
        <dd>
          <span class="price-point-from">From</span> £{prices.oneOff}
        </dd>
      </div>
      <div>
        <dt>Ongoing partnership</dt>
        <dd>
          <span class="price-point-from">From</span> £{prices.ongoing}
          <span class="price-point-unit">/month</span>
        </dd>
      </div>
      <div>
        <dt>New websites</dt>
        <dd class="price-point-text">
          <span class="price-point-from">Per project</span> Quoted separately
        </dd>
      </div>
    </dl>
  </section>

  <section class="section container founder-strip" aria-labelledby="founder-heading">
    {founder.photo && (
      <img
        class="founder-photo"
        src={founder.photo}
        alt={`${founder.name}, ${founder.role.toLowerCase()} of ${business.name}`}
        width={founder.photoWidth}
        height={founder.photoHeight}
        loading="lazy"
        decoding="async"
      />
    )}
    <div>
      <h2 id="founder-heading" class="section-title">
        One person, start to finish.
      </h2>
      <p class="lead">
        Presence is run by {founder.name}, who reviews your site, does the work and answers your
        emails, so nothing gets lost between an account manager and a developer. Your website,
        domain and Google profile stay in your name throughout.
      </p>
      <a class="link-arrow" href="/about/">
        About Presence
      </a>
    </div>
  </section>

  <section class="section container faq-section" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="section-title">
      Before you enquire
    </h2>
    <div class="faq-list">
      <details class="faq">
        <summary>
          Is the audit automated?<span class="faq-symbol" aria-hidden="true"></span>
        </summary>
        <div class="faq-answer">
          <p>
            No. A person reviews the public information you share and explains the findings in plain
            English. Private systems and security testing are outside the free audit.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>
          Do I have to sign up for ongoing support?
          <span class="faq-symbol" aria-hidden="true"></span>
        </summary>
        <div class="faq-answer">
          <p>
            No. The audit is free, and a specific problem can be fixed as a one-off piece of work.
            Any paid work is quoted separately for you to consider.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>
          What if I don’t have a website yet?<span class="faq-symbol" aria-hidden="true"></span>
        </summary>
        <div class="faq-answer">
          <p>
            You can still get in touch. Tell us about your business and what you need, and we’ll
            talk through a new website and quote for it separately.
          </p>
        </div>
      </details>
    </div>
  </section>
</Layout>
