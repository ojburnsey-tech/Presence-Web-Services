---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Wordmark from '../components/Wordmark.astro';
import { business } from '../config/business';
---

<Layout
  title="Free website & Google presence audit"
  description="Request a free, thorough assessment of your public website and Google presence. Understand what needs attention before agreeing to any paid work."
>
  <section class="container audit-landing" aria-labelledby="audit-heading">
    <div class="landing-logo">
      <Wordmark />
    </div>
    <p class="landing-services">
      Websites, ongoing website care and Google Business Profile management
      <br class="desktop-break" /> for independent businesses in Northern Ireland and across the UK.
    </p>
    <h1 id="audit-heading">Start with a free audit.</h1>
    <p class="audit-lead">
      We’ll take a thorough look at your public website and Google presence, then explain the issues
      we find and the improvements worth considering.
    </p>
    <Button class="audit-button" href="/contact/">
      Request a free audit
    </Button>
    <p class="audit-reassurance">No obligation. No account access required.</p>
    <div class="landing-audit-summary">
      <h2>What we’ll look at</h2>
      <dl>
        <div>
          <dt>Your website</dt>
          <dd>
            How clearly your services are explained and whether the pages are straightforward to use
            on a phone.
          </dd>
        </div>
        <div>
          <dt>Your Google presence</dt>
          <dd>
            Whether your public business details are consistent and help customers understand what
            you offer.
          </dd>
        </div>
        <div>
          <dt>Making an enquiry</dt>
          <dd>
            How easy it is to find your contact options and follow the steps to request a quote.
          </dd>
        </div>
      </dl>
      <p>
        We’ll explain our findings and recommend where to start. Any paid work is quoted separately.
      </p>
    </div>
    <div class="landing-context">
      <h2>Practical work, agreed before it starts.</h2>
      <p>
        Unclear service information, out-of-date business details and awkward forms can get in the
        way of an enquiry. We identify the problem, agree the work with you and check the changes.
      </p>
      <p>
        One-off improvements from <strong>£{business.prices.oneOff}</strong>. Ongoing support from{' '}
        <strong>£{business.prices.ongoing}/month</strong>. New websites are quoted separately.
      </p>
      <a href="/pricing/" class="inline-link">
        Compare prices and support
      </a>
    </div>
    <div class="landing-context">
      <p>
        Presence is a new independent business. You deal directly with the person doing the work,
        keep ownership of your accounts and approve changes to your business information.
      </p>
      <a href="/services/" class="inline-link">
        Explore the services
      </a>
    </div>
    <div class="landing-faq">
      <h2>Before you enquire</h2>
      <details class="faq">
        <summary>Is the audit automated?</summary>
        <div class="faq-answer">
          <p>
            No. We assess the publicly available information you share and explain the findings. No
            account access is needed. Private systems and invasive security testing are outside the
            free audit.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>Do I have to buy ongoing support?</summary>
        <div class="faq-answer">
          <p>
            No. The audit is free, with no obligation. A specific issue can be quoted as one-off
            work. Any paid scope and price are agreed separately.
          </p>
        </div>
      </details>
      <details class="faq">
        <summary>What if I do not have a website?</summary>
        <div class="faq-answer">
          <p>
            You can still enquire. Share your business details and what you need. We can discuss a
            new website and quote for it separately.
          </p>
        </div>
      </details>
    </div>
  </section>
</Layout>
