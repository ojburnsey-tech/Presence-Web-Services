---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
import { serviceGroups, services } from '../config/business';
const groups = serviceGroups.map((group) => ({
  ...group,
  items: services.filter((service) => service.group === group.id),
}));
---

<Layout
  title="Website & Google profile services"
  description="Website creation and repairs, ongoing maintenance, Google Business Profile management, local listing accuracy and enquiry improvements for independent businesses."
>
  <PageIntro
    title="Websites, website care and local search."
    description="Whether you need a new website, a few repairs or someone to look after the updates, we agree exactly what’s included before any work starts."
  />
  <nav class="container service-directory" aria-label="Service groups">
    {groups.map((group) => (
      <a href={`#${group.id}`}>{group.name}</a>
    ))}
  </nav>

  {groups.map((group) => (
    <section id={group.id} class="service-group" aria-labelledby={`${group.id}-heading`}>
      <div class="container">
        <header class="service-group-header">
          <h2 id={`${group.id}-heading`}>{group.name}</h2>
          <p class="lead">{group.summary}</p>
        </header>
        {group.items.map((service) => (
          <article id={service.id} class="service-item">
            <div>
              <h3>{service.name}</h3>
              <p>{service.description}</p>
              <a class="inline-link service-action" href={service.cta.href}>
                {service.cta.label}
              </a>
            </div>
            <div>
              <ul class="check-list">
                {service.tasks.map((task) => (
                  <li>{task}</li>
                ))}
              </ul>
              {'note' in service && <p class="fine-print">{service.note}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="section container prose-section" aria-labelledby="scope-heading">
    <h2 id="scope-heading">What we don’t take on</h2>
    <div>
      <p>
        Large custom software, paid advertising campaigns and enterprise SEO are outside what
        Presence offers. New websites, substantial rebuilds and complex technical repairs are
        assessed and quoted separately. No one can guarantee search rankings or business results,
        and we don’t.
      </p>
      <div class="scope-actions">
        <Button href="/contact/">Request a free audit</Button>
        <a class="link-arrow" href="/pricing/">
          Compare prices
        </a>
      </div>
    </div>
  </section>
</Layout>
