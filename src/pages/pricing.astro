---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import PricingCards from '../components/PricingCards.astro';
import FAQ from '../components/FAQ.astro';
import { business } from '../config/business';
---

<Layout
  title="Website support pricing"
  description={`One-off website and Google profile improvements from £${business.prices.oneOff}, or ongoing support from £${business.prices.ongoing}/month. New websites are quoted separately.`}
>
  <PageIntro
    title="Pricing"
    description="Starting prices for the three ways we work. You get a written scope and quote before you commit to anything."
  />
  <section class="container pricing-main" aria-label="Compare support options">
    <PricingCards />
    <p class="fine-print pricing-disclaimer">
      Enquiring doesn’t place an order. Your quote depends on your platform, the condition of the
      website, the access available and what we agree.
    </p>
  </section>
  <section class="section container agreement-section" aria-labelledby="agreement-heading">
    <h2 id="agreement-heading" class="section-title">
      What we agree before starting
    </h2>
    <dl class="agreement-details">
      <div>
        <dt>The work and the cost</dt>
        <dd>
          The tasks, deliverables, timing and payment arrangements, in writing. Any substantial
          extra work is discussed and quoted before it goes ahead.
        </dd>
      </div>
      <div>
        <dt>Access and your input</dt>
        <dd>
          You keep ownership of your accounts and approve changes to your business information. We
          tell you which permissions, content or photographs we need.
        </dd>
      </div>
      <div>
        <dt>Ongoing arrangements</dt>
        <dd>
          For monthly support, the proposal confirms the scope, communication and cancellation
          terms. Hosting, subscriptions and advertising costs are separate unless expressly
          included.
        </dd>
      </div>
    </dl>
  </section>
  <FAQ />
</Layout>
